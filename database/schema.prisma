// Caragua360 — schema do banco de dados (MySQL)
// Todas as entidades de conteúdo oficial estão ligadas a Caraguatatuba/SP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TOURIST
  RESIDENT
}

enum LocalCategory {
  PRAIA
  TRILHA
  CACHOEIRA
  PONTO
}

enum ItineraryStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum SuggestionType {
  NOVO_PONTO
  CORRECAO
  DICA
  RECOMENDACAO
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BalneabilityStatus {
  PROPRIA
  IMPROPRIA
  NAO_AVALIADA
}

enum SustainabilityCategory {
  DICA
  ORIENTACAO
  CAMPANHA
  PROJETO
  DESCARTE
}

model User {
  id           Int       @id @default(autoincrement())
  fullName     String    @db.VarChar(160)
  username     String    @unique @db.VarChar(60)
  email        String    @unique @db.VarChar(191)
  passwordHash String    @db.VarChar(255)
  role         UserRole  @default(TOURIST)
  city         String?   @db.VarChar(120)
  neighborhood String?   @db.VarChar(120)
  photoUrl     String?   @db.VarChar(500)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  itineraries          Itinerary[]          @relation("ItineraryAuthor")
  reviewedItineraries  Itinerary[]          @relation("ItineraryReviewer")
  reviews              Review[]
  comments             Comment[]
  favorites            Favorite[]
  likes                ItineraryLike[]
  suggestions          Suggestion[]         @relation("SuggestionAuthor")
  reviewedSuggestions  Suggestion[]         @relation("SuggestionReviewer")
  resetTokens          PasswordResetToken[]
  createdLocals        Local[]              @relation("LocalCreator")
  sessions             Session[]

  @@index([role])
  @@index([createdAt])
}

/// Sessão emitida no login. Permite logout real (revogação) e expiração.
model Session {
  id        String    @id @db.VarChar(36)
  userId    Int
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?   @db.VarChar(64)
  userAgent String?   @db.VarChar(255)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Registro de tentativas de login para bloqueio temporário por e-mail.
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(191)
  ipAddress String?  @db.VarChar(64)
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Local {
  id              Int           @id @default(autoincrement())
  slug            String        @unique @db.VarChar(160)
  name            String        @db.VarChar(160)
  category        LocalCategory
  description     String        @db.Text
  neighborhood    String?       @db.VarChar(120)
  address         String?       @db.VarChar(255)
  latitude        Decimal?      @db.Decimal(10, 7)
  longitude       Decimal?      @db.Decimal(10, 7)
  access          String?       @db.Text
  accessibility   String?       @db.Text
  capacity        String?       @db.VarChar(120)
  sea             String?       @db.VarChar(160)
  structure       String?       @db.Text
  profile         String?       @db.VarChar(160)
  characteristics Json?
  isActive        Boolean       @default(true)
  isOfficial      Boolean       @default(true)
  createdById     Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  createdBy   User?              @relation("LocalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  photos      LocalPhoto[]
  reviews     Review[]
  comments    Comment[]
  favorites   Favorite[]
  balneability BalneabilityRecord[]
  itineraryPlaces ItineraryPlace[]
  suggestions Suggestion[]

  @@index([category, isActive])
  @@index([neighborhood])
}

model LocalPhoto {
  id        Int    @id @default(autoincrement())
  localId   Int
  url       String @db.VarChar(500)
  caption   String? @db.VarChar(255)
  sortOrder Int    @default(0)

  local Local @relation(fields: [localId], references: [id], onDelete: Cascade)

  @@index([localId])
}

model Accommodation {
  id           Int      @id @default(autoincrement())
  slug         String   @unique @db.VarChar(160)
  name         String   @db.VarChar(160)
  category     String   @default("Pousada") @db.VarChar(40)
  description  String   @db.Text
  neighborhood String?  @db.VarChar(120)
  address      String?  @db.VarChar(255)
  contactPhone String?  @db.VarChar(60)
  contactEmail String?  @db.VarChar(191)
  website      String?  @db.VarChar(255)
  amenities    Json?
  priceRange   String?  @db.VarChar(80)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  photos    AccommodationPhoto[]
  favorites Favorite[]

  @@index([neighborhood, isActive])
}

model AccommodationPhoto {
  id              Int    @id @default(autoincrement())
  accommodationId Int
  url             String @db.VarChar(500)
  caption         String? @db.VarChar(255)
  sortOrder       Int    @default(0)

  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@index([accommodationId])
}

model Restaurant {
  id           Int      @id @default(autoincrement())
  slug         String   @unique @db.VarChar(160)
  name         String   @db.VarChar(160)
  description  String   @db.Text
  neighborhood String?  @db.VarChar(120)
  address      String?  @db.VarChar(255)
  contact      String?  @db.VarChar(160)
  cuisine      String?  @db.VarChar(120)
  openingHours Json?
  priceRange   String?  @db.VarChar(80)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  photos    RestaurantPhoto[]
  favorites Favorite[]

  @@index([neighborhood, isActive])
}

model RestaurantPhoto {
  id           Int    @id @default(autoincrement())
  restaurantId Int
  url          String @db.VarChar(500)
  caption      String? @db.VarChar(255)
  sortOrder    Int    @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model Activity {
  id           Int      @id @default(autoincrement())
  slug         String   @unique @db.VarChar(160)
  name         String   @db.VarChar(160)
  description  String   @db.Text
  neighborhood String?  @db.VarChar(120)
  location     String?  @db.VarChar(255)
  contact      String?  @db.VarChar(160)
  schedule     String?  @db.VarChar(255)
  priceInfo    String?  @db.VarChar(160)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  photos ActivityPhoto[]

  @@index([isActive])
}

model ActivityPhoto {
  id         Int    @id @default(autoincrement())
  activityId Int
  url        String @db.VarChar(500)
  caption    String? @db.VarChar(255)
  sortOrder  Int    @default(0)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

model Event {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(160)
  name        String   @db.VarChar(160)
  description String   @db.Text
  startDate   DateTime
  endDate     DateTime?
  time        String?  @db.VarChar(120)
  place       String   @db.VarChar(160)
  address     String?  @db.VarChar(255)
  entryInfo   String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos EventPhoto[]

  @@index([startDate])
  @@index([isActive])
}

model EventPhoto {
  id        Int    @id @default(autoincrement())
  eventId   Int
  url       String @db.VarChar(500)
  caption   String? @db.VarChar(255)
  sortOrder Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/// Leitura persistida da API de balneabilidade. Mantém a origem e a data da medição.
model BalneabilityRecord {
  id         Int               @id @default(autoincrement())
  beachName  String            @db.VarChar(160)
  localId    Int?
  status     BalneabilityStatus @default(NAO_AVALIADA)
  measuredAt DateTime
  source     String            @db.VarChar(160)
  sourceUrl  String?           @db.VarChar(500)
  raw        Json?
  fetchedAt  DateTime          @default(now())

  local Local? @relation(fields: [localId], references: [id], onDelete: SetNull)

  @@index([beachName, measuredAt])
  @@index([fetchedAt])
}

model Itinerary {
  id              Int             @id @default(autoincrement())
  userId          Int
  title           String          @db.VarChar(160)
  description     String          @db.Text
  daysCount       Int             @default(1)
  startDate       DateTime?
  endDate         DateTime?
  status          ItineraryStatus @default(DRAFT)
  coverPhotoUrl   String?         @db.VarChar(500)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    Int?
  rejectionReason String?         @db.Text
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user       User              @relation("ItineraryAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?             @relation("ItineraryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  days       ItineraryDay[]
  places     ItineraryPlace[]
  photos     ItineraryPhoto[]
  likes      ItineraryLike[]
  favorites  Favorite[]
  reviews    Review[]
  comments   Comment[]

  @@index([status, publishedAt])
  @@index([userId])
}

model ItineraryDay {
  id          Int      @id @default(autoincrement())
  itineraryId Int
  dayNumber   Int
  notes       String?  @db.Text

  itinerary Itinerary        @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  places    ItineraryPlace[]

  @@unique([itineraryId, dayNumber])
}

model ItineraryPlace {
  id            Int      @id @default(autoincrement())
  itineraryId   Int
  dayId         Int
  localId       Int?
  placeName     String   @db.VarChar(160)
  comments      String?  @db.Text
  knewPlace     Boolean?
  visitDate     DateTime?
  visitTime     String?  @db.VarChar(20)
  visitDuration String?  @db.VarChar(60)
  rating        Int?
  sortOrder     Int      @default(0)

  itinerary Itinerary        @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  day       ItineraryDay     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  local     Local?           @relation(fields: [localId], references: [id], onDelete: SetNull)
  photos    ItineraryPhoto[]

  @@index([itineraryId])
  @@index([dayId])
}

model ItineraryPhoto {
  id          Int    @id @default(autoincrement())
  itineraryId Int
  placeId     Int?
  url         String @db.VarChar(500)
  caption     String? @db.VarChar(255)

  itinerary Itinerary      @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  place     ItineraryPlace? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([itineraryId])
}

model Review {
  id          Int      @id @default(autoincrement())
  userId      Int
  localId     Int?
  itineraryId Int?
  rating      Int
  comment     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  local     Local?     @relation(fields: [localId], references: [id], onDelete: Cascade)
  itinerary Itinerary? @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@unique([userId, localId])
  @@unique([userId, itineraryId])
  @@index([localId])
  @@index([itineraryId])
}

model Comment {
  id          Int      @id @default(autoincrement())
  userId      Int
  localId     Int?
  itineraryId Int?
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  local     Local?     @relation(fields: [localId], references: [id], onDelete: Cascade)
  itinerary Itinerary? @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([localId])
  @@index([itineraryId])
}

model Favorite {
  id              Int      @id @default(autoincrement())
  userId          Int
  localId         Int?
  accommodationId Int?
  restaurantId    Int?
  itineraryId     Int?
  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  local         Local?         @relation(fields: [localId], references: [id], onDelete: Cascade)
  accommodation Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  restaurant    Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  itinerary     Itinerary?     @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@unique([userId, localId])
  @@unique([userId, accommodationId])
  @@unique([userId, restaurantId])
  @@unique([userId, itineraryId])
  @@index([userId])
}

model ItineraryLike {
  id          Int      @id @default(autoincrement())
  userId      Int
  itineraryId Int
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@unique([userId, itineraryId])
}

model SustainabilityContent {
  id        Int                  @id @default(autoincrement())
  slug      String               @unique @db.VarChar(160)
  title     String               @db.VarChar(160)
  category  SustainabilityCategory
  summary   String               @db.VarChar(500)
  content   String               @db.Text
  imageUrl  String?              @db.VarChar(500)
  published Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([category, published])
}

model Suggestion {
  id          Int              @id @default(autoincrement())
  userId      Int
  type        SuggestionType
  title       String           @db.VarChar(160)
  description String           @db.Text
  localId     Int?
  status      SuggestionStatus @default(PENDING)
  adminNote   String?          @db.Text
  reviewedAt  DateTime?
  reviewedById Int?
  createdAt   DateTime         @default(now())

  user       User  @relation("SuggestionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("SuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  local      Local? @relation(fields: [localId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
}
