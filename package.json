{
  "name": "caragua360-nestjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.cjs\"",
    "test": "npm run build && node --test test/*.test.cjs",
    "db:generate": "prisma generate --schema database/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema database/schema.prisma",
    "db:seed": "node --import dotenv/config database/seed.js",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "prebuild": "npm run db:generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jose": "6.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "prettier": "^3.6.2",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.0",
    "@nestjs/cli": "^11.0.0"
  }
}
